#define ZMK_POINTING_DEFAULT_MOVE_VAL 800  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/**
 * @brief Mouse and input device configuration for ZMK keyboard firmware
 * 
 * This configuration block sets up mouse movement and scroll behavior parameters:
 * 
 * - mmv_input_listener: Configures mouse movement input scaling with 2x horizontal 
 *   and 1x vertical scaling via zip_xy_scaler processor
 * 
 * - msc_input_listener: Configures mouse scroll input scaling with 2x horizontal 
 *   and 1x vertical scaling via zip_scroll_scaler processor
 * 
 * - msc (Mouse Scroll): 
 *   * acceleration-exponent: Linear acceleration (1) instead of default (0)
 *   * time-to-max-speed-ms: Faster ramp-up time (100ms vs default 300ms)
 *   * delay-ms: No delay before scroll activation (0ms)
 * 
 * - mmv (Mouse Movement):
 *   * time-to-max-speed-ms: Moderate acceleration time (500ms)
 *   * acceleration-exponent: Linear acceleration curve (1)
 *   * trigger-period-ms: 16ms update interval (~60Hz refresh rate)
 * 
 * - soft_off: Requires 2 second hold time before triggering soft power off
 */

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <1000>;
    acceleration-exponent = <2>;
};

&soft_off { hold-time-ms = <2000>; };

&lt { flavor = "hold-preferred"; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 40 28>;
        };

        mo_function {
            bindings = <&mo 3>;
            key-positions = <56 30>;
            slow-release;
        };

        mo_device {
            bindings = <&mo 4>;
            key-positions = <56 30 29>;
            slow-release;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };

        c_self_inc: self_inc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PLUS &kp PLUS>;
            label = "SELF_INC";
        };

        c_self_dec: self_dec {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp MINUS>;
            label = "SELF_DEC";
        };

        c_domain: c_domain {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp COLON>;
            label = "C_DOMAIN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default_Dvorak {
            bindings = <
&kp GRAVE         &kp N1        &kp N2        &kp N3        &kp N4       &kp N5        &kp UP_ARROW     &kp N6     &kp N7     &kp N8    &kp N9  &kp N0      &kp EQUAL
&kp TAB           &kp SQT       &kp COMMA     &kp DOT       &kp P        &kp Y         &kp DOWN_ARROW   &kp F      &kp G      &kp C     &kp R   &kp L       &kp FSLH
&kp LEFT_CONTROL  &kp A         &kp O         &kp E         &kp U        &kp I         &kp LEFT_ARROW   &kp D      &kp H      &kp T     &kp N   &kp S       &kp MINUS
&kp LSHFT         &kp SEMI      &kp Q         &kp J         &kp K        &kp X         &kp RIGHT_ARROW  &kp B      &kp M      &kp W     &kp V   &kp Z       &kp RSHFT
&kp C_MUTE        &kp CAPSLOCK  &kp LEFT_ALT  &kp LEFT_GUI  &lt 2 SPACE  &kp ESCAPE    &kp ENTER        &kp ENTER  &kp SPACE  &kp BSPC  &mo 3   &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "Dflt.DV";
        };

        QWERTY {
            bindings = <
&kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4  &kp N5     &mmv MOVE_UP     &kp N6     &kp N7     &kp N8     &kp N9   &kp N0      &kp EQUAL
&kp TAB    &kp Q     &kp W     &kp E     &kp R   &kp T      &mmv MOVE_DOWN   &kp Y      &kp U      &kp I      &kp O    &kp P       &kp FSLH
&kp LCTRL  &kp A     &kp S     &kp D     &kp F   &kp G      &mmv MOVE_LEFT   &kp H      &kp J      &kp K      &kp L    &kp SEMI    &kp APOS
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V   &kp B      &mmv MOVE_RIGHT  &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH    &kp RSHFT
&trans     &kp CAPS  &kp LALT  &kp LGUI  &mo 2   &kp ESC    &mkp LCLK        &kp ENTER  &kp SPACE  &kp BSPC   &mo 3    &kp DELETE
            >;

            display-name = "QWERTY";
            sensor-bindings = <&scroll_encoder>;
        };

        Symbol {
            bindings = <
&kp TILDE   &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &mmv MOVE_UP     &kp CARET    &kp AMPS              &kp STAR               &kp LPAR  &kp RPAR          &kp PLUS
&trans      &trans    &trans  &trans    &trans    &to 4        &mmv MOVE_DOWN   &c_self_inc  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans    &trans            &kp BACKSLASH
&trans      &trans    &trans  &trans    &mo 3     &trans       &mmv MOVE_LEFT   &c_self_dec  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LT    &kp GREATER_THAN  &kp UNDER
&trans      &trans    &trans  &trans    &trans    &trans       &mmv MOVE_RIGHT  &c_domain    &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans    &trans            &trans
&kp C_MUTE  &trans    &trans  &trans    &mo 2     &to 0        &mkp LCLK        &trans       &trans                &trans                 &trans    &trans
            >;

            display-name = "Symbol";
            sensor-bindings = <&scroll_encoder>;
        };

        Function {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4                    &kp F5               &trans  &kp F6         &kp F7    &kp F8        &kp F9     &kp F10          &kp F11
&trans  &trans  &trans  &trans  &kp C_BRIGHTNESS_INC      &kp C_VOLUME_UP      &trans  &kp PAGE_UP    &kp HOME  &kp UP_ARROW  &kp END    &kp PRINTSCREEN  &kp F12
&trans  &trans  &trans  &mo 4   &kp C_BRIGHTNESS_DEC      &kp C_VOLUME_DOWN    &trans  &kp PAGE_DOWN  &kp LEFT  &kp DOWN      &kp RIGHT  &trans           &trans
&trans  &trans  &trans  &trans  &kp C_BRIGHTNESS_MINIMUM  &kp C_MUTE           &trans  &trans         &trans    &trans        &trans     &trans           &trans
&trans  &trans  &trans  &trans  &mo 2                     &trans               &trans  &trans         &trans    &trans        &trans     &trans
            >;

            display-name = "Function";
            sensor-bindings = <&scroll_encoder>;
        };

        Device {
            bindings = <
&trans  &trans      &trans  &trans        &trans      &trans    &trans  &trans          &trans          &trans          &trans           &trans    &trans
&trans  &to 4       &to 5   &to 6         &to 7       &trans    &trans  &msc SCRL_UP    &mkp MB3        &mmv MOVE_UP    &trans           &trans    &trans
&trans  &to 0       &to 1   &to 2         &to 3       &trans    &trans  &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB2  &trans
&trans  &sys_reset  &trans  &out OUT_TOG  &bt BT_NXT  &trans    &trans  &trans          &trans          &trans          &trans           &trans    &trans
&trans  &bt BT_CLR  &trans  &trans        &mo 2       &trans    &trans  &trans          &mkp MB1        &trans          &trans           &trans
            >;

            display-name = "Device";
            sensor-bindings = <&scroll_encoder>;
        };

        Function_Only {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans   &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &mo 2   &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "FO";
            sensor-bindings = <&scroll_encoder>;
        };

        Extra1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &mo 2   &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Extra1";
            sensor-bindings = <&scroll_encoder>;
        };

        Extra2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &mo 2   &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Extra2";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
